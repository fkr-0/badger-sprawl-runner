{
	"name": "badger-sprawl-runner-workspace",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Sprite-first cyber-badger 2D platformer with modular architecture.",
	"packageManager": "pnpm@9.0.0",
	"keywords": [
		"platformer",
		"game",
		"canvas",
		"2d"
	],
	"scripts": {
		"dev": "pnpm -F @badger/runner dev",
		"build": "pnpm -r build",
		"test": "node tests/validate-data.mjs && node tests/runtime-contracts.mjs && node tests/sprite-prompt-grid-contracts.mjs && pnpm -r test",
			"test:e2e": "playwright test",
			"test:e2e:ui": "playwright test --ui",
			"test:e2e:debug": "playwright test --debug",
			"test:e2e:headed": "playwright test --headed",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"typecheck": "pnpm -r typecheck",
		"smoke:runner": "node tests/smoke-runner.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.8.3",
		"@playwright/test": "^1.60.0",
		"@vitest/ui": "^1.0.0",
		"typescript": "^5.3.3",
		"vite": "^5.1.0",
		"vitest": "^1.0.0"
	}
}
