{
	"name": "badger-sprawl-runner-workspace",
	"version": "1.5.2",
	"private": true,
	"type": "module",
	"main": "desktop/main.mjs",
	"desktopName": "dev.arcade.badger-sprawl-runner",
	"description": "Sprite-first cyber-badger 2D platformer with modular architecture.",
	"packageManager": "pnpm@9.0.0",
	"keywords": [
		"platformer",
		"game",
		"canvas",
		"2d"
	],
	"scripts": {
		"dev": "pnpm -F @badger/runner dev",
		"desktop:dev": "node desktop/dev.mjs",
		"desktop:dir": "pnpm build && electron-builder --dir --linux",
		"desktop:appimage": "pnpm build && electron-builder --linux AppImage",
		"build": "pnpm -r build && node scripts/publish-artifact.mjs",
		"test": "node tests/validate-data.mjs && node tests/runtime-sprite-manifest.mjs && node tests/runtime-contracts.mjs && node tests/release-packet-contract.mjs && node tests/release-appimage-workflow-contract.mjs && node tests/sprite-prompt-grid-contracts.mjs && node tests/sprite-prompt-corpus-contracts.mjs && python3 scripts/generate-sprite-render-prompts.py --check && python3 tests/sprite-atlas-assembly-contract.py && node tests/story-content-loader.mjs && node tests/animation-contracts.mjs && node tests/public-sprite-assets.mjs && python3 scripts/integrate-chronicle-first-sprite-set.py --check && node tests/production-sprite-coverage.mjs && node tests/dalle-sprite-integration.mjs && node scripts/audit-sprite-usage.mjs && pnpm -r test",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:headed": "playwright test --headed",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"typecheck": "pnpm -r typecheck",
		"smoke:runner": "node tests/smoke-runner.mjs",
		"smoke:artifact": "node tests/artifact-bundle-browser.mjs",
		"sprites:placeholder": "node scripts/generate-placeholder-sprites.mjs",
		"sprites:missing": "node scripts/generate-missing-sprites.mjs",
		"sprites:missing:dry": "node scripts/generate-missing-sprites.mjs --dry-run",
		"sprites:check": "node tests/public-sprite-assets.mjs",
		"sprites:prompts": "python3 scripts/generate-sprite-render-prompts.py",
		"sprites:prompts:check": "python3 scripts/generate-sprite-render-prompts.py --check && node tests/sprite-prompt-corpus-contracts.mjs",
		"sprites:assemble": "python3 scripts/assemble-sprite-atlas.py",
		"sprites:assemble:check": "python3 tests/sprite-atlas-assembly-contract.py",
		"sprites:chronicle:first-set": "python3 scripts/integrate-chronicle-first-sprite-set.py",
		"sprites:chronicle:first-set:check": "python3 scripts/integrate-chronicle-first-sprite-set.py --check",
		"sprites:import:dalle": "./scripts/copy-dalle-sprites.sh",
		"sprites:import:dalle:dry": "./scripts/copy-dalle-sprites.sh --dry-run",
		"sprites:audit:dalle": "./scripts/copy-dalle-sprites.sh --report-only",
		"sprites:audit:usage": "node scripts/audit-sprite-usage.mjs",
		"sprites:progression": "python3 scripts/generate-progression-sprites.py",
		"sprites:moss-motion": "python3 scripts/promote-moss-motion-atlas.py",
		"sprites:mirror-palace": "python3 scripts/generate-mirror-palace-parallax.py",
		"test:e2e:details": "playwright test tests/e2e/details-targets.spec.ts --project=chromium --reporter=line --output=/tmp/badger-sprawl-runner-details-test-results",
		"verify:details": "pnpm -r typecheck && pnpm -r test && pnpm run test:e2e:details && node tests/no-e2e-artifact-churn.mjs",
		"test:e2e:drainmarket": "playwright test tests/e2e/drainmarket-vertical-slice.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-drainmarket-test-results",
		"test:e2e:chrome-arcology": "playwright test tests/e2e/chrome-arcology-vertical-slice.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-chrome-arcology-test-results",
		"test:e2e:mirror-palace": "playwright test tests/e2e/mirror-palace-vertical-slice.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-mirror-palace-test-results",
		"test:e2e:dub-colony": "playwright test tests/e2e/dub-colony-vertical-slice.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-dub-colony-test-results",
		"test:e2e:late-campaign": "playwright test tests/e2e/late-campaign-vertical-slice.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-late-campaign-test-results",
		"test:e2e:progression": "playwright test tests/e2e/progression-skill-tree.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-progression-test-results",
		"test:e2e:training": "playwright test tests/e2e/training-mode.spec.ts tests/e2e/gameplay-ui-release-contract.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-training-test-results",
		"test:e2e:dalle-sprites": "playwright test tests/e2e/dalle-sprite-runtime.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-dalle-sprite-results",
		"test:e2e:sprite-review": "playwright test tests/e2e/sprite-render-review.spec.ts tests/e2e/sprite-visual-review.spec.ts --project=chromium --reporter=line --output=/tmp/badger-sprawl-runner-sprite-review-results",
		"test:e2e:release": "node scripts/run-isolated-playwright.mjs --project=chromium --project=firefox",
		"evidence:core": "BADGER_COLLECT_RELEASE_EVIDENCE=1 vitest run --config vitest.release-evidence.config.ts",
		"evidence:browser": "playwright test tests/e2e/release-evidence.spec.ts tests/e2e/lower-sprawl-vertical-slice.spec.ts tests/e2e/drainmarket-vertical-slice.spec.ts tests/e2e/chrome-arcology-vertical-slice.spec.ts tests/e2e/mirror-palace-vertical-slice.spec.ts tests/e2e/dub-colony-vertical-slice.spec.ts tests/e2e/late-campaign-vertical-slice.spec.ts --config playwright.release-evidence.config.ts",
		"evidence:finalize": "node scripts/finalize-release-evidence.mjs",
		"verify:release": "pnpm run release:plan:check && pnpm run test && pnpm run typecheck && pnpm run build && pnpm run smoke:runner && pnpm run smoke:artifact && pnpm run lint && pnpm run test:e2e:release",
		"materialize:artifact-lab": "cd .. && node app-hub-v11/server/artifact-build.mjs --out .artifacts-deploy-stage --no-build",
		"stage:artifact-lab": "pnpm run verify:release && pnpm run materialize:artifact-lab",
		"deploy:artifact-lab:dry-run": "pnpm run verify:release && cd .. && ./artifacts-deploy --dry-run",
		"deploy:artifact-lab": "pnpm run verify:release && cd .. && ./artifacts-deploy",
		"release:plan:check": "node scripts/verify-release-train.mjs",
		"release:packet:check": "node scripts/verify-release-packet.mjs"
	},
	"build": {
		"appId": "dev.arcade.badger-sprawl-runner",
		"productName": "Badger Sprawl Runner",
		"asar": true,
		"directories": { "output": "release" },
		"files": ["apps/runner/dist/**/*", "desktop/main.mjs", "package.json"],
		"artifactName": "${productName}-${version}-${arch}.${ext}",
		"toolsets": { "appimage": "1.0.3" },
		"linux": { "target": ["AppImage"], "category": "Game", "syncDesktopName": true }
	},
	"devDependencies": {
		"@arcade/runtime": "workspace:*",
		"@biomejs/biome": "^1.8.3",
		"@playwright/test": "^1.60.0",
		"@vitest/ui": "^1.0.0",
		"electron": "^43.4.1",
		"electron-builder": "^26.15.3",
		"typescript": "^5.3.3",
		"vite": "^5.1.0",
		"vitest": "^1.0.0"
	}
}
