{
	"name": "badger-sprawl-runner-workspace",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"description": "Sprite-first cyber-badger 2D platformer with modular architecture.",
	"packageManager": "pnpm@9.0.0",
	"keywords": ["platformer", "game", "canvas", "2d"],
	"scripts": {
		"dev": "pnpm -F @badger/runner dev",
		"build": "pnpm -r build && node scripts/publish-artifact.mjs",
		"test": "node tests/validate-data.mjs && node tests/runtime-contracts.mjs && node tests/sprite-prompt-grid-contracts.mjs && node tests/story-content-loader.mjs && node tests/animation-contracts.mjs && node tests/public-sprite-assets.mjs && node tests/production-sprite-coverage.mjs && pnpm -r test",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:headed": "playwright test --headed",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"typecheck": "pnpm -r typecheck",
		"smoke:runner": "node tests/smoke-runner.mjs",
		"smoke:artifact": "node tests/artifact-bundle-browser.mjs",
		"sprites:placeholder": "node scripts/generate-placeholder-sprites.mjs",
		"sprites:missing": "node scripts/generate-missing-sprites.mjs",
		"sprites:missing:dry": "node scripts/generate-missing-sprites.mjs --dry-run",
		"sprites:check": "node tests/public-sprite-assets.mjs",
		"sprites:progression": "python3 scripts/generate-progression-sprites.py",
		"sprites:moss-motion": "python3 scripts/promote-moss-motion-atlas.py",
		"sprites:mirror-palace": "python3 scripts/generate-mirror-palace-parallax.py",
		"test:e2e:details": "playwright test tests/e2e/details-targets.spec.ts --project=chromium --reporter=line --output=/tmp/badger-sprawl-runner-details-test-results",
		"verify:details": "pnpm -r typecheck && pnpm -r test && pnpm run test:e2e:details && node tests/no-e2e-artifact-churn.mjs",
		"test:e2e:drainmarket": "playwright test tests/e2e/drainmarket-vertical-slice.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-drainmarket-test-results",
		"test:e2e:chrome-arcology": "playwright test tests/e2e/chrome-arcology-vertical-slice.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-chrome-arcology-test-results",
		"test:e2e:mirror-palace": "playwright test tests/e2e/mirror-palace-vertical-slice.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-mirror-palace-test-results",
		"test:e2e:dub-colony": "playwright test tests/e2e/dub-colony-vertical-slice.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-dub-colony-test-results",
		"test:e2e:progression": "playwright test tests/e2e/progression-skill-tree.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-progression-test-results",
		"test:e2e:training": "playwright test tests/e2e/training-mode.spec.ts tests/e2e/gameplay-ui-release-contract.spec.ts --project=chromium --project=firefox --reporter=line --output=/tmp/badger-sprawl-runner-training-test-results",
		"verify:release": "pnpm run test && pnpm run typecheck && pnpm run build && pnpm run smoke:runner && pnpm run smoke:artifact && pnpm run lint && pnpm exec playwright test --project=chromium",
		"materialize:artifact-lab": "cd .. && node app-hub-v11/server/artifact-build.mjs --out .artifacts-deploy-stage --no-build",
		"stage:artifact-lab": "pnpm run verify:release && pnpm run materialize:artifact-lab",
		"deploy:artifact-lab:dry-run": "pnpm run verify:release && cd .. && ./artifacts-deploy --dry-run",
		"deploy:artifact-lab": "pnpm run verify:release && cd .. && ./artifacts-deploy"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.8.3",
		"@playwright/test": "^1.60.0",
		"@vitest/ui": "^1.0.0",
		"typescript": "^5.3.3",
		"vite": "^5.1.0",
		"vitest": "^1.0.0"
	}
}
