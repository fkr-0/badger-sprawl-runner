{
	"files": {
		"ignore": [
			".claude/worktrees/**",
			".ws-bridge/**",
			"release-evidence/**",
			".worktrees/**",
			"**/*.test.ts",
			"tests/e2e/**",
			"test-results/**",
			"playwright-report/**",
			"apps/runner/dist/**",
			"**/dist/**",
			"vendor/**",
			"workflow.json"
		],
		"maxSize": 2097152
	},
	"$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"formatter": {
		"enabled": true,
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useConst": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "es5"
		}
	},
	"json": {
		"formatter": {
			"indentWidth": 2
		}
	}
}
