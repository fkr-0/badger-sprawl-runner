    "./testing": {
      "types": "./testing.d.mts",
      "import": "./testing.mjs"
    },
    "./compat": {
      "types": "./compat.d.mts",
      "import": "./compat.mjs"
    }
  },
  "types": "./index.d.mts",
  "files": [
    "*.mjs",
    "*.d.mts",
    "package.json"
  ]
}
