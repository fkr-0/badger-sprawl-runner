      "types": "./animation.d.mts",
      "import": "./animation.mjs"
    },
    "./pixi": {
      "types": "./pixi.d.mts",
      "import": "./pixi.mjs"
    },
    "./sprites": {
      "types": "./sprites.d.mts",
      "import": "./sprites.mjs"
    },
    "./assets": {
      "types": "./assets.d.mts",
      "import": "./assets.mjs"
    },
    "./audio": {
      "types": "./audio.d.mts",
      "import": "./audio.mjs"
    },
    "./gameplay": {
      "types": "./gameplay.d.mts",
      "import": "./gameplay.mjs"
    },
    "./stages": {
      "types": "./stages.d.mts",
      "import": "./stages.mjs"
    },
    "./storage": {
      "types": "./storage.d.mts",
